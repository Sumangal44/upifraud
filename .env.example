# ============================================================================
# UPI Fraud Detection — Environment Configuration
# Copy to .env and adjust. Values below are the docker-compose defaults.
# ============================================================================

# --- Redpanda / Kafka -------------------------------------------------------
REDPANDA_BROKERS=redpanda:9092
KAFKA_TOPIC_TX_RAW=upi.tx.raw
KAFKA_TOPIC_DECISIONS=upi.decisions
KAFKA_TOPIC_ALERTS=upi.alerts

# --- Feature stores ---------------------------------------------------------
DRAGONFLY_HOST=dragonfly
DRAGONFLY_PORT=6379
MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687

# --- Internal HTTP services -------------------------------------------------
INFERENCE_URL=http://inference:8001
XAI_URL=http://xai:8002
STREAM_API_URL=http://stream-api:8081

# --- Risk policy thresholds -------------------------------------------------
RISK_BLOCK_THRESHOLD=0.80
RISK_CHALLENGE_THRESHOLD=0.50
GNN_SCORE_WEIGHT=0.6
TABULAR_SCORE_WEIGHT=0.4

# --- Service bind addresses (inside containers) -----------------------------
GATEWAY_BIND=0.0.0.0:8080
STREAM_API_BIND=0.0.0.0:8081

# --- Portal (browser-facing) ------------------------------------------------
NEXT_PUBLIC_STREAM_API_URL=http://localhost:8081

# --- XAI / local LLM (optional; empty = deterministic template briefs) ------
VLLM_BASE_URL=
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Logging ----------------------------------------------------------------
RUST_LOG=info,upifraud=debug
