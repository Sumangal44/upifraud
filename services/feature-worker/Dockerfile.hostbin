# syntax=docker/dockerfile:1
# Runtime-only image for feature-worker — see scripts/hostbuild.sh.
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY .hostbuild/feature-worker /usr/local/bin/feature-worker

ENV RUST_LOG=info
CMD ["feature-worker"]
